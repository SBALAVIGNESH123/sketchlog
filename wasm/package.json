{
  "name": "@sketchlog/wasm",
  "version": "1.2.4",
  "description": "Bounded-memory SketchLog WebAssembly runtime",
  "main": "sketchlog.js",
  "types": "sketchlog.d.ts",
  "exports": {
    ".": {
      "types": "./sketchlog.d.ts",
      "require": "./sketchlog.js",
      "default": "./sketchlog.js"
    }
  },
  "files": [
    "sketchlog.js",
    "sketchlog.d.ts",
    "dist/sketchlog.js",
    "dist/sketchlog.wasm"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:build-script && npm run build && node test/smoke.cjs",
    "test:build-script": "node --test test/build-script.test.mjs",
    "test:browser": "node test/browser-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.53.2"
  },
  "keywords": ["sketchlog", "wasm", "observability", "streaming"],
  "author": "Bala Vignesh S",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SBALAVIGNESH123/sketchlog.git",
    "directory": "wasm"
  },
  "bugs": {
    "url": "https://github.com/SBALAVIGNESH123/sketchlog/issues"
  },
  "homepage": "https://github.com/SBALAVIGNESH123/sketchlog/tree/main/wasm",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
